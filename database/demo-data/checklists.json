                "is_active": 1,
                "created_by_id": "@analysts.admin"
            },
            {
                "_ref": "tpl_offboard",
                "title": "Employee offboarding",
                "category": "HR & IT",
                "scope": "both",
                "keywords": "offboarding, leaver, termination, revoke, return, exit",
