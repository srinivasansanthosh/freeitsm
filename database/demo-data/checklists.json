                "closure_mode": "block",
                "is_active": 1,
                "created_by_id": "@analysts.admin"
            },
            {
                "_ref": "tpl_decom",
                "title": "Server decommissioning",
                "category": "Infrastructure",
                "scope": "ticket",
                "keywords": "decommission, retire, server, hypervisor, teardown, wipe",
